# Copy to automation/.env for local runs; on Railway set these as service variables.
# The pipeline holds two secrets: a GitHub token (commit datasets) and an Airtable
# token (write firm rows). Both scoped to one repo / one base.

# --- GitHub (commit refreshed / new datasets) ---
GITHUB_TOKEN=github_pat_xxx        # fine-grained PAT, Contents: read+write on the ONE repo
GITHUB_REPO=michaeleverywhere/vc-comp   # owner/name
GITHUB_BRANCH=main
GITHUB_DATA_DIR=data

# --- Airtable (direct write into Private Comps) ---
AIRTABLE_PAT=pat_xxx               # data.records:read + data.records:write on the base
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Private Comps

# --- tuning ---
SCRAPER_TIMEOUT=600                # per-bespoke-scraper subprocess budget (seconds)
GENERIC_CONFIDENCE=0.6             # new-firm extraction below this -> needs-scraper

# --- scraper factory (auto-generate bespoke scrapers; discover mode only) ---
# Every value below is a DEFAULT already baked into the code — set them only to
# override. The refresh service needs none of this and no Anthropic key.
ANTHROPIC_API_KEY=sk-ant-xxx       # enables generation; set a spend limit in the console
GEN_MODEL=claude-sonnet-4-5        # strong model: the last GEN_STRONG_TRIES tries
GEN_MODEL_CHEAP=claude-haiku-4-5   # cheap model: the earlier tries. Set equal to
                                   # GEN_MODEL to turn escalation off entirely.
GEN_STRONG_TRIES=2                 # how many of a burst's tries use the strong model.
                                   # 2, not 1 — one leaves it no room to iterate.
GEN_MAX_ATTEMPTS=4                 # generation tries per firm, ALL in its first run
                                   # (burst; each retry sees the earlier failures,
                                   # labelled with the model that produced them);
                                   # exhausting them RETIRES the firm — re-arm by
                                   # editing data/gen_attempts.json
GEN_MAX_PER_RUN=3                  # cap FIRMS generated per run (not dollars)
GEN_RUN_TIMEOUT=420                # sandbox budget per candidate scraper (seconds)
GEN_MAX_TOKENS=8000                # max output tokens per generation call

# --- spend ceiling (data/spend.json, per calendar month) ---
MONTHLY_BUDGET_USD=4.50            # factory pauses when a burst no longer fits;
                                   # rolls over on the 1st by itself. Measured:
                                   # a firm a day costs ~$3.09/month.
GEN_COST_ESTIMATE=0.25             # assumed cost of one burst when deciding to start

# --- candidate finder (tops up the discovery queue; discover mode only) ---
FIND_MAX_PER_RUN=1                 # new firms queued per run
FIND_MAX_OPEN=25                   # pause finding while this many are still pending
                                   # (retired / written-off firms don't count)
FIND_PROPOSALS=12                  # firms asked for per call; most get rejected
FIND_MODEL=claude-sonnet-4-5       # one small call per run, ~$0.006

# --- generic scrape memory (data/scrape_attempts.json) ---
# Default is EMPTY: one failed extraction and the firm is never scraped again.
# Set a comma-separated day list to restore widening retries instead.
# SCRAPE_BACKOFF_DAYS=1,3,7,30
